# Copia questo file in .env e personalizza i valori.
# Genera una chiave con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-questa-chiave

# development | production
FLASK_CONFIG=development

# Database: SQLite di default (file in instance/). Per PostgreSQL:
# DATABASE_URL=postgresql+psycopg://utente:password@localhost/lifetracker
DATABASE_URL=

# Fuso orario di riferimento
APP_TIMEZONE=Europe/Rome

# Metti a 1 se l'app è servita solo via HTTPS (es. tailscale serve / certificato)
SESSION_COOKIE_SECURE=0

# Consenti la registrazione libera di nuovi account (1) o solo tramite codice invito (0)
ALLOW_REGISTRATION=1

# Dimensione massima upload in MB
MAX_UPLOAD_MB=10

# Livello log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
